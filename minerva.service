# systemd service for the minerva OPDS catalog server.
#
# Install:
#   cargo build --release
#   sudo install -Dm755 target/release/minerva /usr/local/bin/minerva
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin minerva
#   sudo install -Dm644 minerva.service /etc/systemd/system/minerva.service
#   # optionally drop config in /etc/minerva/minerva.env (see EnvironmentFile below)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now minerva
#
# Logs: journalctl -u minerva -f   (level via RUST_LOG below)

[Unit]
Description=minerva OPDS 2.0 catalog server
Documentation=https://specs.opds.io/opds-2.0.html
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/minerva

# --- Configuration ---------------------------------------------------------
# OPDS_LIBRARY_DIR (a directory of EPUB files) is required — set it here or in
# the env file. The catalog + user database lives in the state directory below.
Environment=OPDS_LIBRARY_DIR=/usr/share/books
Environment=OPDS_DB=/var/lib/minerva/opds.db
# The externally-visible URL clients see (behind the reverse proxy).
Environment=OPDS_BASE_URL=http://minerva.lan
# The internal address the server binds; the reverse proxy forwards here.
Environment=OPDS_LISTEN=127.0.0.1:4343
Environment=RUST_LOG=minerva=info,tower_http=info,warn
# Max admin upload size (MiB). Keep this <= any reverse proxy's body limit
# (nginx: client_max_body_size). Default is 64.
Environment=OPDS_MAX_UPLOAD_MIB=128
EnvironmentFile=-/etc/minerva/minerva.env

# --- Identity & state ------------------------------------------------------
# A dedicated unprivileged user. StateDirectory creates and owns
# /var/lib/minerva (0700) for the SQLite database (and its -wal/-shm files).
User=minerva
Group=minerva
StateDirectory=minerva
StateDirectoryMode=0700
WorkingDirectory=/var/lib/minerva

Restart=on-failure
RestartSec=5

# --- Hardening -------------------------------------------------------------
# The server binds an unprivileged port and needs no capabilities.
# If you serve on a privileged port (e.g. 80/443), add:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# The state dir (database) is writable; add the library dir too if you want
# admin uploads to work (it must match OPDS_LIBRARY_DIR).
ReadWritePaths=/var/lib/minerva /usr/share/books
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=077

[Install]
WantedBy=multi-user.target
